# Copy this file to ".env" and fill in the two values. Never share or commit the real .env.

# The database to read from
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# The key callers must send in the X-API-Key header. At least 24 characters, random.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
DATA_API_KEY=
